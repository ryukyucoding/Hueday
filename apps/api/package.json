{
  "name": "@hueday/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --var ALLOW_SIMULATE:1",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hueday/core": "*",
    "hono": "^4.7.0",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0",
    "tsx": "^4.19.0"
  }
}
